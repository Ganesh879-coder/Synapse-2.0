# Kavach Backend Configuration
KAVACH_ENV=development
KAVACH_LOG_LEVEL=INFO
DATA_DIR=
DB_URL=
FILE_TTL_MINUTES=60
DELETE_AFTER_VIEW=false
KAVACH_MAX_UPLOAD_BYTES=15728640
KAVACH_PDF_DPI=200
MAX_PIXELS=25000000
MAX_PDF_PAGES=10
KAVACH_ANALYZER_TIMEOUT_SECONDS=45.0
KAVACH_OCR_TIMEOUT_SECONDS=60.0
REQUEST_TIMEOUT_SECONDS=120.0
MAX_CONCURRENT_JOBS=2
MAX_QUEUE_LENGTH=16
KAVACH_API_KEYS=change-me-local-dev-key
KAVACH_RATE_LIMIT=30/minute
TRUSTED_PROXIES=127.0.0.1,::1
CORS_ORIGINS=http://localhost:5173
SENTRY_DSN=

# Optional LLM Configuration
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
KAVACH_LLM_API_URL=
KAVACH_LLM_API_KEY=

# Frontend Configuration (never set VITE_MOCK=1 in production)
VITE_API_BASE=http://localhost:8000
